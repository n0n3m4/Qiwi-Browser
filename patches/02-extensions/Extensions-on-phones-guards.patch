 chrome/browser/usb/BUILD.gn                           |  1 +
 chrome/browser/usb/chrome_usb_delegate.cc             |  7 ++++++-
 extensions/browser/extension_host.cc                  |  8 ++++++++
 11 files changed, 54 insertions(+), 13 deletions(-)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/multiwindow/MultiWindowUtils.java b/chrome/android/java/src/org/chromium/chrome/browser/multiwindow/MultiWindowUtils.java
index 91b820bb66..ad557d1543 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/multiwindow/MultiWindowUtils.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/multiwindow/MultiWindowUtils.java
@@ -559,9 +559,9 @@ public class MultiWindowUtils implements ActivityStateListener {
             return intent;
         }
 
-        assert !isIncognito : "Opening an incognito window isn't supported";
-        assert isInMultiWindowMode || isInMultiDisplayMode
-                : "Current windowing mode doesn't support opening a new window";
+        // kiwi: extensions (chrome.windows.create) can ask for a window in any mode; fail
+        // gracefully instead of asserting when the legacy path cannot open one.
+        if (isIncognito || !(isInMultiWindowMode || isInMultiDisplayMode)) return null;
 
         Class<? extends Activity> targetActivity =
                 getInstance().getOpenInOtherWindowActivity(sourceActivity);
diff --git a/chrome/browser/extensions/api/developer_private/developer_private_functions.cc b/chrome/browser/extensions/api/developer_private/developer_private_functions.cc
index c563bd59c9..4f759b8b0b 100644
--- a/chrome/browser/extensions/api/developer_private/developer_private_functions.cc
+++ b/chrome/browser/extensions/api/developer_private/developer_private_functions.cc
@@ -1773,9 +1773,13 @@ DeveloperPrivateDismissSafetyHubExtensionsMenuNotificationFunction::Run() {
   }
 
   Profile* profile = Profile::FromBrowserContext(browser_context());
-  SafetyHubMenuNotificationServiceFactory::GetForProfile(profile)
-      ->DismissActiveNotificationOfModule(
-          safety_hub::SafetyHubModuleType::EXTENSIONS);
+  // The service is null for off-the-record profiles (chrome://extensions
+  // opened in an incognito tab); there is nothing to dismiss then.
+  if (auto* service =
+          SafetyHubMenuNotificationServiceFactory::GetForProfile(profile)) {
+    service->DismissActiveNotificationOfModule(
+        safety_hub::SafetyHubModuleType::EXTENSIONS);
+  }
   return RespondNow(NoArguments());
 }
 
