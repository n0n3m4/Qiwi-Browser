 .../layouts/content/TitleBitmapFactory.java   |  2 +
 .../compositor/layouts/phone/StackLayout.java | 40 ++++++++++++++++++-
 .../layouts/phone/StackLayoutBase.java        | 10 +++++
 .../compositor/layouts/phone/stack/Stack.java |  2 +-
 5 files changed, 52 insertions(+), 4 deletions(-)

