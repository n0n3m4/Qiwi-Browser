+        if (mStacks.isEmpty()) return;
+        mStacks.get(getTabStackIndex()).tabSelectingEffect(time, mNextTabId);
+        startMarginAnimation(false);
+        startYOffsetAnimation(false);
+        finishScrollStacks();
+    }
