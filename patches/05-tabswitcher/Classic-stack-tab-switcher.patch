+/**
+ * Layout that displays all normal tabs in one stack and all incognito tabs in a second.
+ *
+ * <p>Ported from M90. In 153 this layout serves {@link
+ * org.chromium.chrome.browser.layouts.LayoutType#HUB} on phones (see LayoutManagerChromePhone)
+ * and brings its own top bar, because 153's phone toolbar is INVISIBLE while HUB is showing.
+ */
+// TODO(stack): Not @NullMarked yet (NullAway only checks annotated classes). Annotate later.
+public class StackLayout extends StackLayoutBase {
+    public static final int NORMAL_STACK_INDEX = 0;
+    public static final int INCOGNITO_STACK_INDEX = 1;
+
+    private static final int MENU_ID_NEW_INCOGNITO_TAB = 1;
+    private static final int MENU_ID_CLOSE_ALL_TABS = 2;
+    private static final int MENU_ID_SETTINGS = 3;
+
+    /** Whether the current fling animation is the result of switching stacks. */
+    private boolean mFlingFromModelChange;
+
+    /** Tells the layout manager to re-query {@link #handlesBackPress()}. */
+    private final Runnable mOnBackPressStateChanged;
+
+    // Top bar (new tab, incognito toggle, tab count, overflow menu).
+    private @Nullable View mTopBar;
+    private @Nullable ImageButton mIncognitoToggle;
+    private @Nullable TextView mTabCountView;
+    private @Nullable ImageButton mNewTabButton;
+    private @Nullable ImageButton mMenuButton;
+    private final int mTopBarFallbackHeightPx;
+    private int mTopBarInsetTopPx;
+
+    // Last state pushed to the top bar / back press supplier (see refreshTopBarAndBackState()).
+    private int mShownTabCount = -1;
+    private int mShownIncognitoCount = -1;
+    private int mShownIncognitoSelected = -1;
+    private boolean mShownHandlesBackPress;
+
+    /**
+     * @param context The current Android's context.
+     * @param updateHost The {@link LayoutUpdateHost} view for this layout.
+     * @param renderHost The {@link LayoutRenderHost} view for this layout.
+     * @param browserControlsStateProvider The {@link BrowserControlsStateProvider}.
+     * @param onBackPressStateChanged Called when {@link #handlesBackPress()} may have changed.
+     */
+    public StackLayout(
+            Context context,
+            LayoutUpdateHost updateHost,
+            LayoutRenderHost renderHost,
+            BrowserControlsStateProvider browserControlsStateProvider,
+            Runnable onBackPressStateChanged) {
+        super(context, updateHost, renderHost, browserControlsStateProvider);
+        mOnBackPressStateChanged = onBackPressStateChanged;
+        mTopBarFallbackHeightPx =
+                context.getResources().getDimensionPixelSize(R.dimen.toolbar_height_no_shadow);
+    }
+
+    @Override
+    public void setTabModelSelector(TabModelSelector modelSelector) {
+        super.setTabModelSelector(modelSelector);
+        // If the models don't exist yet (https://crbug.com/1142858), onCurrentTabModelChanged()
+        // sets the lists once TabModelSelectorBase#initialize() publishes the first model.
+        if (!modelSelector.getModels().isEmpty()) setTablists();
+    }
+
+    @Override
+    protected void onCurrentTabModelChanged(TabModel model) {
+        if (mStacks.isEmpty()) setTablists();
+        super.onCurrentTabModelChanged(model);
+    }
+
+    private void setTablists() {
+        // A 153 TabModel is a flat TabList with grouped tabs inline: the stack shows every tab
+        // and ignores groups.
+        List<TabList> tabLists =
+                List.of(mTabModelSelector.getModel(false), mTabModelSelector.getModel(true));
+        setTabLists(tabLists);
+    }
+
+    @Override
+    protected int getTabStackIndex(int tabId) {
+        if (tabId == Tab.INVALID_TAB_ID) {
+            if (mTemporarySelectedStack != INVALID_STACK_INDEX) return mTemporarySelectedStack;
+
+            return mTabModelSelector.isIncognitoSelected()
+                    ? INCOGNITO_STACK_INDEX
+                    : NORMAL_STACK_INDEX;
+        } else {
+            return mTabModelSelector.getModel(true).getTabById(tabId) != null
+                    ? INCOGNITO_STACK_INDEX
+                    : NORMAL_STACK_INDEX;
+        }
+    }
+
+    @Override
+    protected void onTabClosing(long time, int id) {
+        super.onTabClosing(time, id);
+        // Just in case we closed the last tab of a stack we need to trigger the overlap animation.
+        startMarginAnimation(true);
+        // Animate the stack to leave incognito mode.
+        if (!mStacks.get(INCOGNITO_STACK_INDEX).isDisplayable()) onTabModelSwitched(false);
+    }
+
+    @Override
+    protected void onTabsAllClosing(long time, boolean incognito) {
+        super.onTabsAllClosing(time, incognito);
+        getTabStackAtIndex(incognito ? INCOGNITO_STACK_INDEX : NORMAL_STACK_INDEX)
+                .tabsAllClosingEffect(time);
+        // trigger the overlap animation.
+        startMarginAnimation(true);
+        // Animate the stack to leave incognito mode.
+        if (!mStacks.get(INCOGNITO_STACK_INDEX).isDisplayable()) onTabModelSwitched(false);
+    }
+
+    @Override
+    public void onTabClosureCancelled(long time, int id, boolean incognito) {
+        super.onTabClosureCancelled(time, id, incognito);
+        getTabStackAtIndex(incognito ? INCOGNITO_STACK_INDEX : NORMAL_STACK_INDEX)
+                .undoClosure(time, id);
+    }
+
+    @Override
+    public void onTabCreated(
+            long time,
+            int id,
+            int tabIndex,
+            int sourceId,
+            boolean newIsIncognito,
+            boolean background,
+            float originX,
+            float originY) {
+        super.onTabCreated(
+                time, id, tabIndex, sourceId, newIsIncognito, background, originX, originY);
+        onTabModelSwitched(newIsIncognito);
+    }
+
+    @Override
+    protected void onTabModelSwitched(boolean toIncognitoTabModel) {
+        if (mStacks.isEmpty()) return;
+        flingStacks(toIncognitoTabModel ? INCOGNITO_STACK_INDEX : NORMAL_STACK_INDEX);
+        mFlingFromModelChange = true;
+    }
+
+    @Override
+    protected void onAnimationFinished() {
+        super.onAnimationFinished();
+        mFlingFromModelChange = false;
+        if (mTemporarySelectedStack != INVALID_STACK_INDEX) {
+            mTabModelSelector.selectModel(mTemporarySelectedStack == INCOGNITO_STACK_INDEX);
+            mTemporarySelectedStack = INVALID_STACK_INDEX;
+        }
+    }
+
+    @Override
+    protected int getMinRenderedScrollOffset() {
+        // If there's at least one incognito tab open, or we're in the process of switching back
+        // from incognito to normal mode, return -1 so we don't cause any clamping. Otherwise,
+        // return 0 to prevent scrolling.
+        if (mStacks.get(INCOGNITO_STACK_INDEX).isDisplayable() || mFlingFromModelChange) return -1;
+        return 0;
+    }
+
+    @Override
+    public void uiRequestingCloseTab(long time, int id) {
+        super.uiRequestingCloseTab(time, id);
+
+        int incognitoCount = mTabModelSelector.getModel(true).getCount();
+        TabModel model = mTabModelSelector.getModelForTabId(id);
+        if (model != null && model.isIncognito()) incognitoCount--;
+        boolean incognitoVisible = incognitoCount > 0;
+
+        // Make sure we show/hide both stacks depending on which tab we're closing.
+        startMarginAnimation(true, incognitoVisible);
+        if (!incognitoVisible) onTabModelSwitched(false);
+    }
+
+    @Override
+    protected @SwipeMode int computeInputMode(long time, float x, float y, float dx, float dy) {
+        if (mStacks.size() == 2 && !mStacks.get(1).isDisplayable()) return SwipeMode.SEND_TO_STACK;
+        return super.computeInputMode(time, x, y, dx, dy);
+    }
+
+    @Override
+    public void setActiveStackState(int stackIndex) {
+        if (stackIndex != getTabStackIndex(Tab.INVALID_TAB_ID)) {
+            if (stackIndex == NORMAL_STACK_INDEX) {
+                RecordUserAction.record("MobileStackViewNormalMode");
+            } else {
+                RecordUserAction.record("MobileStackViewIncognitoMode");
+            }
+        }
+
+        super.setActiveStackState(stackIndex);
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Top bar. 153's phone toolbar has no tab switcher mode any more, so the switcher brings
+    // its own minimal bar: incognito toggle, tab count, new tab, overflow menu.
+    // ---------------------------------------------------------------------------------------
+
+    @Override
+    public void attachViews(ViewGroup container) {
+        super.attachViews(container);
+        View topBar = getOrCreateTopBar(container);
+        if (topBar.getParent() == null) {
+            container.addView(
+                    topBar,
+                    new FrameLayout.LayoutParams(
+                            ViewGroup.LayoutParams.MATCH_PARENT,
+                            ViewGroup.LayoutParams.WRAP_CONTENT));
+        }
+        applyTopInset(topBar);
+        resetTopBarState();
+    }
+
+    private void applyTopInset(View topBar) {
+        WindowInsetsCompat insets = ViewCompat.getRootWindowInsets(topBar);
+        if (insets == null) return;
+        Insets bars =
+                insets.getInsets(
+                        WindowInsetsCompat.Type.systemBars()
+                                | WindowInsetsCompat.Type.displayCutout());
+        mTopBarInsetTopPx = bars.top;
+        topBar.setPadding(0, bars.top, 0, 0);
+    }
+
+    @Override
+    public void detachViews() {
+        super.detachViews();
+        if (mTopBar != null && mTopBar.getParent() != null) {
+            ((ViewGroup) mTopBar.getParent()).removeView(mTopBar);
+        }
+    }
+
+    @Override
+    public void show(long time, boolean animate) {
+        resetTopBarState();
+        super.show(time, animate);
+    }
+
+    @Override
+    protected void updateLayout(long time, long dt) {
+        super.updateLayout(time, dt);
+        refreshTopBarAndBackState();
+    }
+
+    /** The stack is laid out below our own top bar instead of the browser controls. */
+    @Override
+    public float getTopContentOffsetDp() {
+        int heightPx =
+                mTopBar != null && mTopBar.getHeight() > 0
+                        ? mTopBar.getHeight()
+                        : mTopBarFallbackHeightPx + mTopBarInsetTopPx;
+        return heightPx / mDpToPx;
+    }
+
+    private View getOrCreateTopBar(ViewGroup container) {
+        if (mTopBar != null) return mTopBar;
+
+        View topBar =
+                LayoutInflater.from(getContext())
+                        .inflate(R.layout.stack_tab_switcher_toolbar, container, false);
+        mIncognitoToggle = topBar.findViewById(R.id.stack_incognito_toggle);
+        mTabCountView = topBar.findViewById(R.id.stack_tab_count);
+        mNewTabButton = topBar.findViewById(R.id.stack_new_tab_button);
+        mMenuButton = topBar.findViewById(R.id.stack_menu_button);
+
+        mIncognitoToggle.setOnClickListener(
+                v -> {
+                    if (shouldIgnoreTouchInput() || mTabModelSelector == null) return;
+                    // Fires onCurrentTabModelChanged() -> onTabModelSwitched() -> flingStacks().
+                    mTabModelSelector.selectModel(!mTabModelSelector.isIncognitoSelected());
+                });
+        mNewTabButton.setOnClickListener(v -> launchNtp(isIncognitoStackShown()));
+        mMenuButton.setOnClickListener(this::showOverflowMenu);
+
+        // Edge-to-edge: keep the bar's controls below the status bar. Chrome consumes the
+        // dispatched insets above android.R.id.content, so read the root insets instead.
+        ViewCompat.setOnApplyWindowInsetsListener(
+                topBar,
+                (v, insets) -> {
+                    applyTopInset(v);
+                    return insets;
+                });
+        // The stack geometry depends on the bar height.
+        topBar.addOnLayoutChangeListener(
+                (v, left, top, right, bottom, oldLeft, oldTop, oldRight, oldBottom) -> {
+                    if (bottom - top != oldBottom - oldTop && isActive()) {
+                        notifySizeChanged(getWidth(), getHeight(), getOrientation());
+                    }
+                });
+
+        mTopBar = topBar;
+        return topBar;
+    }
+
+    private boolean isIncognitoStackShown() {
+        return getTabStackIndex(Tab.INVALID_TAB_ID) == INCOGNITO_STACK_INDEX;
+    }
+
+    private void launchNtp(boolean incognito) {
+        if (shouldIgnoreTouchInput() || mTabModelSelector == null) return;
+        // TODO(stack): Respect incognito availability (policy / IncognitoUtils) before offering
+        // incognito tabs.
+        mTabModelSelector
+                .getTabCreatorManager()
+                .getTabCreator(incognito)
+                .launchNtp(TabLaunchType.FROM_TAB_SWITCHER_UI);
+    }
+
+    private void showOverflowMenu(View anchor) {
+        if (mTabModelSelector == null) return;
+        // TODO(stack): Plain PopupMenu instead of the app menu (AppMenuCoordinator needs plumbing
+        // from RootUiCoordinator).
+        PopupMenu popup = new PopupMenu(getContext(), anchor);
+        Menu menu = popup.getMenu();
+        menu.add(Menu.NONE, MENU_ID_NEW_INCOGNITO_TAB, 0, R.string.menu_new_incognito_tab);
+        menu.add(Menu.NONE, MENU_ID_CLOSE_ALL_TABS, 1, R.string.menu_close_all_tabs)
+                .setEnabled(mTabModelSelector.getCurrentModel().getCount() > 0);
+        menu.add(Menu.NONE, MENU_ID_SETTINGS, 2, R.string.menu_settings);
+        popup.setOnMenuItemClickListener(
+                item -> {
+                    int id = item.getItemId();
+                    if (id == MENU_ID_NEW_INCOGNITO_TAB) {
+                        launchNtp(/* incognito= */ true);
+                    } else if (id == MENU_ID_CLOSE_ALL_TABS) {
+                        // The stack animates via willCloseTabs(isAllTabs=true).
+                        mTabModelSelector
+                                .getCurrentModel()
+                                .getTabRemover()
+                                .closeTabs(
+                                        TabClosureParams.closeAllTabs().build(),
+                                        /* allowDialog= */ false);
+                    } else if (id == MENU_ID_SETTINGS) {
+                        SettingsNavigationFactory.createSettingsNavigation()
+                                .startSettings(getContext());
+                    } else {
+                        return false;
+                    }
+                    return true;
+                });
+        popup.show();
+    }
+
+    private void resetTopBarState() {
+        mShownTabCount = -1;
+        mShownIncognitoCount = -1;
+        mShownIncognitoSelected = -1;
+        refreshTopBarAndBackState();
+    }
+
+    /**
+     * Pushes tab counts / incognito state to the top bar and back press state to the layout
+     * manager when they changed.
+     */
+    private void refreshTopBarAndBackState() {
+        // ponytail: polled once per frame from updateLayout() instead of observing every model
+        // event; frames are requested on every model change the stack animates. Switch to
+        // TabModelObserver callbacks if the bar ever lags behind.
+        if (mTabModelSelector == null) return;
+
+        boolean handlesBack = handlesBackPress();
+        if (handlesBack != mShownHandlesBackPress) {
+            mShownHandlesBackPress = handlesBack;
+            mOnBackPressStateChanged.run();
+        }
+
+        if (mTopBar == null) return;
+        boolean incognitoSelected = mTabModelSelector.isIncognitoSelected();
+        int tabCount = mTabModelSelector.getCurrentModel().getCount();
+        int incognitoCount = mTabModelSelector.getModel(true).getCount();
+        int incognitoSelectedInt = incognitoSelected ? 1 : 0;
+        if (tabCount == mShownTabCount
+                && incognitoCount == mShownIncognitoCount
+                && incognitoSelectedInt == mShownIncognitoSelected) {
+            return;
+        }
+        mShownTabCount = tabCount;
+        mShownIncognitoCount = incognitoCount;
+        mShownIncognitoSelected = incognitoSelectedInt;
+
+        Context context = getContext();
+        mTopBar.setBackgroundColor(
+                ChromeColors.getPrimaryBackgroundColor(context, incognitoSelected));
+        ColorStateList tint = ChromeColors.getPrimaryIconTint(context, incognitoSelected);
+        mIncognitoToggle.setImageTintList(tint);
+        mNewTabButton.setImageTintList(tint);
+        mMenuButton.setImageTintList(tint);
+        mTabCountView.setTextColor(tint);
+        mTabCountView.setText(NumberFormat.getIntegerInstance().format(tabCount));
+
+        // Like M90, the incognito stack (and its toggle) only exists while incognito tabs do.
+        mIncognitoToggle.setVisibility(
+                incognitoCount > 0 || incognitoSelected ? View.VISIBLE : View.INVISIBLE);
+        mIncognitoToggle.setSelected(incognitoSelected);
+        mNewTabButton.setContentDescription(
+                context.getString(
+                        incognitoSelected
+                                ? R.string.accessibility_toolbar_btn_new_incognito_tab
+                                : R.string.accessibility_toolbar_btn_new_tab));
+    }
+}
