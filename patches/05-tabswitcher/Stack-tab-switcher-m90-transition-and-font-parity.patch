+++ b/chrome/android/java/src/org/chromium/chrome/browser/compositor/layouts/content/TitleBitmapFactory.java
@@ -97,6 +97,8 @@ public class TitleBitmapFactory {
                 /* applyTextSize= */ true,
                 !mIncognito);
         mTabTextPaint.setFakeBoldText(fakeBoldText);
+        // 13sp on phones (stack switcher cards, as in M90), 14sp = TextMedium on sw600dp.
+        mTabTextPaint.setTextSize(res.getDimension(R.dimen.compositor_tab_title_text_size));
         mTabTextPaint.density = density;
         enforceMaxTextHeight(mTabTextPaint, tabStripHeightPx);
 
