     public @Nullable ExtensionsToolbarCoordinator getExtensionsToolbarCoordinator() {
-        return mExtensionsToolbarCoordinator;
+        if (mExtensionsToolbarCoordinatorFactory == null || mTabModelSelector == null) return null;
+        Profile profile = mTabModelSelector.getCurrentModel().getProfile();
+        if (profile == null) return null;
+        // ponytail: tablets show the container in the toolbar and would need it swapped on every
+        // Incognito switch; they keep the single regular-profile coordinator.
+        if (mIsTablet) profile = profile.getOriginalProfile();
+        ExtensionsToolbarCoordinator coordinator = mExtensionsToolbarCoordinators.get(profile);
+        if (coordinator == null) {
+            coordinator = mExtensionsToolbarCoordinatorFactory.apply(profile);
+            if (coordinator == null) return null;
+            mExtensionsToolbarCoordinators.put(profile, coordinator);
+            // Hides the new container and gives its popups the toolbar as anchor (phones).
+            mToolbar.setExtensionsToolbarCoordinator(coordinator);
+        }
+        return coordinator;
     }
 
