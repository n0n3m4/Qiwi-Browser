+            pinch0TabIndex = getTabIndexAtPositon(pinch0X, pinch0Y);
+            pinch1TabIndex = getTabIndexAtPositon(pinch1X, pinch1Y);
+            // If any of them is invalid we invalidate both.
+            if (pinch0TabIndex < 0 || pinch1TabIndex < 0) {
+                pinch0TabIndex = -1;
+                pinch1TabIndex = -1;
