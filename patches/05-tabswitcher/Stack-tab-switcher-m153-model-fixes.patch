-                    // TabClosureMethodRefactor is off by default in 153, so a close-all only
-                    // sends the legacy willCloseAllTabs, never willCloseTabs.
-                    // ponytail: single/multiple legacy closes still rely on uiRequestingCloseTab;
-                    // mirror willCloseTab/willCloseMultipleTabs if model-driven closes must animate.
+                    // TabClosureMethodRefactor is off by default in 153, so closes only send the
+                    // legacy willCloseTab / willCloseMultipleTabs / willCloseAllTabs. Mirror them
+                    // so closes the stack didn't start (archiver, chrome.tabs.remove,
+                    // window.close()) drop their cards. Cards the stack is already discarding are
+                    // ignored by Stack#tabClosingEffect (isDying).
+                    @Override
+                    public void willCloseTab(Tab tab, boolean didCloseAlone) {
+                        // A close-all/multiple also sends willCloseTab per tab; handled below.
+                        if (!isActive() || !didCloseAlone) return;
+                        onTabClosing(LayoutManagerImpl.time(), tab.getId());
+                    }
+
+                    @Override
+                    public void willCloseMultipleTabs(boolean allowUndo, List<Tab> tabs) {
+                        if (!isActive()) return;
+                        long time = LayoutManagerImpl.time();
+                        for (Tab tab : tabs) onTabClosing(time, tab.getId());
+                    }
