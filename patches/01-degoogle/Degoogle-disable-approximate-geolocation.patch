From fd908548a349b64ddd3e0d691eb97571700b3c52 Mon Sep 17 00:00:00 2001
From: build <build@localhost>
Date: Fri, 16 Oct 2026 18:48:33 +0500
Subject: [PATCH] Degoogle: disable ApproximateGeolocationPermission (no GMS
 location provider)

Without Google Play services the build falls back to LocationProviderAndroid,
which refuses approximate requests whenever the app holds the fine-location
permission ("Cannot generate approximate location.", error code 2). Sites that
were granted location therefore never got a position. With the feature off the
permission prompt is the plain Allow/Block one and every request goes to the
Android LocationManager as before M13x.

Found by the runtime web test (testing/RUNTIME_WEB.md, F4).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 components/content_settings/core/common/features.cc | 11 +++++------
 1 file changed, 5 insertions(+), 6 deletions(-)

diff --git a/components/content_settings/core/common/features.cc b/components/content_settings/core/common/features.cc
index c1b2c0e77f..7c7b77472a 100644
--- a/components/content_settings/core/common/features.cc
+++ b/components/content_settings/core/common/features.cc
@@ -39,13 +39,12 @@ const base::FeatureParam<bool> kSafetyCheckUnusedSitePermissionsWithDelay{
     &kSafetyCheckUnusedSitePermissions,
     "unused-site-permissions-with-delay-for-testing", false};
 
+// Degoogle: without Play services the plain Android LocationProviderAndroid
+// cannot produce a coarse fix and answers every approximate request with a
+// position error, so the Precise/Approximate split is disabled (see
+// LocationProviderAndroid.start()).
 BASE_FEATURE(kApproximateGeolocationPermission,
-#if BUILDFLAG(IS_ANDROID)
-             base::FEATURE_ENABLED_BY_DEFAULT
-#else
-             base::FEATURE_DISABLED_BY_DEFAULT
-#endif
-);
+             base::FEATURE_DISABLED_BY_DEFAULT);
 
 BASE_FEATURE(kLeftHandSideActivityIndicators, base::FEATURE_ENABLED_BY_DEFAULT);
 
