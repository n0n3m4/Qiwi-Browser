+        if (tabId == Tab.INVALID_TAB_ID) tabId = mTabModelSelector.getCurrentTabId();
+        mNextTabId = tabId;
+        // startHiding() runs the selecting effect (see startTabSelectingEffect()).
+        startHiding();
+    }
