diff --git a/chrome/android/java/src/org/chromium/chrome/browser/tabbed_mode/MoreToolsItemBuilder.java b/chrome/android/java/src/org/chromium/chrome/browser/tabbed_mode/MoreToolsItemBuilder.java
index 87a01b790b..e65da435ef 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/tabbed_mode/MoreToolsItemBuilder.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/tabbed_mode/MoreToolsItemBuilder.java
@@ -265,15 +265,15 @@ public class MoreToolsItemBuilder {
     }
 
     /** Builds the "Dev tools" menu item. */
-    public ListItem buildDevToolsItem() {
+    public ListItem buildDevToolsItem(boolean showIcon) {
         return AppMenuItemUtils.createStandardListItem(
                 AppMenuItemUtils.buildModelForStandardMenuItem(
                         mContext,
                         mAppMenuItemTheme,
                         R.id.dev_tools,
                         R.string.menu_dev_tools,
-                        Resources.ID_NULL,
+                        showIcon ? R.drawable.ic_devtools_24dp : Resources.ID_NULL,
                         mIsMenuIconAtStart),
-                /* showIcon= */ false);
+                showIcon);
     }
 }
