+                            mStackTabs[pinch0TabIndex].getScrollOffset() + oldScrollTarget;
+                    float tab0Screen = scrollToScreen(tab0ScrollSpace);
+                    float tab0ScrollFinal = screenToScroll(tab0Screen + screenDelta0);
