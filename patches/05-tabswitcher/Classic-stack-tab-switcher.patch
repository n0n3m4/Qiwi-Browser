diff --git a/chrome/android/java/res/layout/stack_tab_switcher_toolbar.xml b/chrome/android/java/res/layout/stack_tab_switcher_toolbar.xml
new file mode 100644
index 0000000000..47cf6a0ae0
--- /dev/null
+++ b/chrome/android/java/res/layout/stack_tab_switcher_toolbar.xml
@@ -0,0 +1,53 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Copyright 2026 The Chromium Authors
+     Use of this source code is governed by a BSD-style license that can be
+     found in the LICENSE file. -->
+
+<!-- Top bar shown by the phone stack tab switcher (StackLayout). The regular phone toolbar is
+     INVISIBLE while LayoutType.HUB is showing, so the switcher brings its own controls. -->
+<LinearLayout
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:app="http://schemas.android.com/apk/res-auto"
+    android:id="@+id/stack_tab_switcher_toolbar"
+    android:layout_width="match_parent"
+    android:layout_height="wrap_content"
+    android:minHeight="@dimen/toolbar_height_no_shadow"
+    android:layout_gravity="top"
+    android:gravity="center_vertical"
+    android:orientation="horizontal"
+    android:clickable="true"
+    android:focusable="false">
+
+    <org.chromium.ui.widget.ChromeImageButton
+        android:id="@+id/stack_incognito_toggle"
+        style="@style/ToolbarButton"
+        android:layout_height="@dimen/toolbar_height_no_shadow"
+        android:src="@drawable/ic_incognito_24dp"
+        android:contentDescription="@string/accessibility_tab_switcher_incognito_stack"
+        app:tint="@color/default_icon_color_tint_list" />
+
+    <TextView
+        android:id="@+id/stack_tab_count"
+        android:layout_width="0dp"
+        android:layout_height="wrap_content"
+        android:layout_weight="1"
+        android:gravity="center"
+        android:textAppearance="@style/TextAppearance.TextLarge.Primary"
+        android:importantForAccessibility="no" />
+
+    <org.chromium.ui.widget.ChromeImageButton
+        android:id="@+id/stack_new_tab_button"
+        style="@style/ToolbarButton"
+        android:layout_height="@dimen/toolbar_height_no_shadow"
