+            // kiwi: phones keep regular and Incognito tabs in one Activity, and each profile has
+            // its own AndroidBrowserWindow. Upstream only gave the startup profile's window an
+            // extension window controller, so with an Incognito tab in front windows.* functions
+            // (getLastFocused) dereferenced a null controller and killed the browser.
+            Profile profile = tabModelSelector.getModel(/* incognito= */ false).getProfile();
