+
+    /** Bundle key carrying the extension action ID of a row built by addExtensionActionItems. */
+    public static final String EXTENSION_ACTION_ID_BUNDLE_KEY = "ExtensionActionId";
+
+    // Rows of the last built menu -> action ID. Not a model key: STANDARD row views are recycled
+    // across models, which requires every STANDARD model to have the same key set.
+    private final Map<PropertyModel, String> mExtensionActionIds = new HashMap<>();
+
+    // kiwi: the list is read from the bridge on every menu build, so it follows installs/removals.
+    private void addExtensionActionItems(MVCListAdapter.ModelList modelList) {
+        mExtensionActionIds.clear();
+        if (!shouldShowExtensionsItem()) return;
+        ExtensionsToolbarCoordinator coordinator = mToolbarManager.getExtensionsToolbarCoordinator();
+        if (coordinator == null) return;
+        for (String actionId : coordinator.getActionIds()) {
+            Bitmap icon = coordinator.getActionIcon(actionId);
+            PropertyModel model =
+                    AppMenuItemUtils.buildBaseModelForTextItem(
+                                    getAppMenuItemTheme(),
+                                    R.id.extension_action_menu_id,
+                                    isMenuIconAtStart())
+                            .with(AppMenuItemProperties.TITLE, coordinator.getActionName(actionId))
+                            .with(
+                                    AppMenuItemProperties.ICON,
+                                    icon == null
+                                            ? null
+                                            : new BitmapDrawable(mContext.getResources(), icon))
+                            .with(AppMenuItemProperties.ICON_NO_TINT, true)
+                            .build();
+            mExtensionActionIds.put(model, actionId);
+            modelList.add(AppMenuItemUtils.createStandardListItem(model, /* showIcon= */ true));
+        }
+    }
+
+    @Override
+    public @Nullable Bundle getBundleForMenuItem(PropertyModel model) {
+        String actionId = mExtensionActionIds.get(model);
+        if (actionId != null) {
+            Bundle bundle = new Bundle();
+            bundle.putString(EXTENSION_ACTION_ID_BUNDLE_KEY, actionId);
+            return bundle;
+        }
+        return super.getBundleForMenuItem(model);
     }
 
