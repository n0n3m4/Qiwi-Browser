+    /**
+     * Leaves a visible stack once it may no longer be used (an accessibility service or the
+     * incognito lock was turned on while it was up). The next tab switcher show picks the Hub.
+     */
+    public void exitStackIfUnusable() {
+        if (mStackLayout == null
+                || getActiveLayout() != mStackLayout
+                || mStackLayout.isStartingToHide()
+                || !mStackLayout.handlesBackPress()
+                || canUseStackLayout()) {
+            return;
+        }
+        showLayout(LayoutType.BROWSING, /* animate= */ false);
+    }
