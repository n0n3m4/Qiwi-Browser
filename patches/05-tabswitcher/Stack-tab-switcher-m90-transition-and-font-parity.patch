 import org.chromium.chrome.browser.tabmodel.TabModel;
 import org.chromium.chrome.browser.tabmodel.TabModelSelector;
 import org.chromium.components.browser_ui.styles.ChromeColors;
+import org.chromium.ui.interpolators.Interpolators;
 
 import java.util.List;
 
@@ -55,6 +56,7 @@ public class StackLayout extends StackLayoutBase {
     private static final int MENU_ID_NEW_INCOGNITO_TAB = 1;
     private static final int MENU_ID_CLOSE_ALL_TABS = 2;
     private static final int MENU_ID_SETTINGS = 3;
+    private static final long TOP_BAR_FADE_DURATION_MS = 200;
 
     /** Whether the current fling animation is the result of switching stacks. */
     private boolean mFlingFromModelChange;
@@ -68,6 +70,8 @@ public class StackLayout extends StackLayoutBase {
     private @Nullable ImageButton mMenuButton;
     private final int mTopBarFallbackHeightPx;
     private int mTopBarInsetTopPx;
+    // Set from startHiding() until the next show(): the bar is fading out and ignores clicks.
+    private boolean mTopBarFadingOut;
 
     // Last state pushed to the top bar / back press supplier (see refreshTopBarAndBackState()).
     private int mShownIncognitoSelected = -1;
@@ -265,6 +269,8 @@ public class StackLayout extends StackLayoutBase {
     public void detachViews() {
         super.detachViews();
         if (mTopBar != null && mTopBar.getParent() != null) {
+            mTopBar.animate().cancel();
+            mTopBar.setAlpha(1f);
             ((ViewGroup) mTopBar.getParent()).removeView(mTopBar);
         }
     }
@@ -272,9 +278,33 @@ public class StackLayout extends StackLayoutBase {
     @Override
     public void show(long time, boolean animate) {
         resetTopBarState();
+        mTopBarFadingOut = false;
+        if (mTopBar != null) {
+            mTopBar.animate().cancel();
+            mTopBar.setAlpha(animate ? 0f : 1f);
+            if (animate) fadeTopBar(1f);
+        }
         super.show(time, animate);
     }
 
+    @Override
+    public void startHiding() {
+        super.startHiding();
+        // M90's TabSwitcherModeTTPhone faded the switcher toolbar out from the first frame of the
+        // exit, so the card's composited toolbar crossfades into its place.
+        mTopBarFadingOut = true;
+        if (mTopBar != null) fadeTopBar(0f);
+    }
+
+    /** M90 TopToolbarCoordinator.TAB_SWITCHER_MODE_NORMAL_ANIMATION_DURATION_MS, linear. */
+    private void fadeTopBar(float alpha) {
+        assert mTopBar != null;
+        mTopBar.animate()
+                .alpha(alpha)
+                .setDuration(TOP_BAR_FADE_DURATION_MS)
+                .setInterpolator(Interpolators.LINEAR_INTERPOLATOR);
+    }
+
     @Override
     protected void updateLayout(long time, long dt) {
         super.updateLayout(time, dt);
@@ -300,8 +330,14 @@ public class StackLayout extends StackLayoutBase {
         mNewTabButton = topBar.findViewById(R.id.stack_new_tab_button);
         mMenuButton = topBar.findViewById(R.id.stack_menu_button);
 
-        mNewTabButton.setOnClickListener(v -> launchNtp(isIncognitoStackShown()));
-        mMenuButton.setOnClickListener(this::showOverflowMenu);
+        mNewTabButton.setOnClickListener(
+                v -> {
+                    if (!mTopBarFadingOut) launchNtp(isIncognitoStackShown());
+                });
+        mMenuButton.setOnClickListener(
+                v -> {
+                    if (!mTopBarFadingOut) showOverflowMenu(v);
+                });
 
         // Edge-to-edge: keep the bar's controls below the status bar. Chrome consumes the
         // dispatched insets above android.R.id.content, so read the root insets instead.
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/compositor/layouts/phone/StackLayoutBase.java b/chrome/android/java/src/org/chromium/chrome/browser/compositor/layouts/phone/StackLayoutBase.java
index b359fde1b8..3894544276 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/compositor/layouts/phone/StackLayoutBase.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/compositor/layouts/phone/StackLayoutBase.java
@@ -1403,6 +1403,16 @@ public abstract class StackLayoutBase extends Layout {
         return mBrowserControls.getContentOffset() / mDpToPx;
     }
 
+    /**
+     * @return Where the selected tab's content sits outside the switcher, in dp: the browser
+     *     controls' content offset, which M90 used for the static tab position on enter and exit.
+     *     StackLayout lays the stack out below its own bar instead, which also covers the status
+     *     bar that the compositor does not draw under.
+     */
+    public final float getBrowsingContentOffsetDp() {
+        return mBrowserControls.getContentOffset() / mDpToPx;
+    }
+
     /**
      * @return The offset of the content from the bottom of the screen in dp.
      */
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/compositor/layouts/phone/stack/Stack.java b/chrome/android/java/src/org/chromium/chrome/browser/compositor/layouts/phone/stack/Stack.java
