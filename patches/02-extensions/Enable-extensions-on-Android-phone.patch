@@ -819,6 +821,24 @@ void ExtensionService::OnExtensionHostRenderProcessGone(
       FROM_HERE, base::BindOnce(&ExtensionRegistrar::TerminateExtension,
                                 extension_registrar_->GetWeakPtr(),
                                 extension_host->extension_id()));
+
+#if BUILDFLAG(IS_ANDROID)
+  // kiwi: Android has no crash bubble to revive a killed background page (the
+  // OS kills renderers under memory pressure), so reload it after a short
+  // delay.
+  // ponytail: per-session retry cap shared by all profiles; reset per id on
+  // success if crash loops after long uptimes matter.
+  static base::NoDestructor<std::map<ExtensionId, int>> reload_counts;
+  constexpr int kMaxAutoReloads = 5;
+  if (++(*reload_counts)[extension_host->extension_id()] <= kMaxAutoReloads) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&ExtensionRegistrar::ReloadExtensionWithQuietFailure,
+                       extension_registrar_->GetWeakPtr(),
+                       extension_host->extension_id()),
+        base::Seconds(2));
+  }
+#endif
 }
 
