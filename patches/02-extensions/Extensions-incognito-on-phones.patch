+    // kiwi: the Incognito window exists only while the Incognito TabModel has tabs. The task
+    // creates it in its own IncognitoTabModelObserver, registered before this one, so the window
+    // is there when ours runs. Keying the feature to the TabModel removes it before that window is
+    // destroyed when the last Incognito tab closes.
+    private void addIncognitoExtensionWindowController(
+            ChromeAndroidTask chromeAndroidTask,
+            TabModelSelector tabModelSelector,
+            ActivityWindowAndroid activityWindowAndroid) {
+        IncognitoTabModel incognitoModel =
+                (IncognitoTabModel) tabModelSelector.getModel(/* incognito= */ true);
+        Runnable addController =
+                () -> {
+                    Profile incognitoProfile = incognitoModel.getProfile();
+                    if (incognitoProfile == null
+                            || chromeAndroidTask.getNativeBrowserWindowPtr(incognitoProfile, this)
+                                    == 0) {
+                        return;
+                    }
+                    chromeAndroidTask.addFeature(
+                            new ChromeAndroidTaskFeatureKey(
+                                    ExtensionWindowControllerBridge.class,
+                                    incognitoProfile,
+                                    activityWindowAndroid,
+                                    incognitoModel),
+                            ExtensionWindowControllerBridgeFactory::create);
+                };
+        incognitoModel.addIncognitoObserver(
+                new IncognitoTabModelObserver() {
+                    @Override
+                    public void onIncognitoModelCreated() {
+                        addController.run();
+                    }
+                });
+        addController.run();
+    }
+
     /** Returns an {@link OneshotSupplier} for {@link ChromeAndroidTask}. */
