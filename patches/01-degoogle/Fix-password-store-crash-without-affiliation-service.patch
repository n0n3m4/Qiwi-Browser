From 818f2294b5388dd81fe1e6eaac2be3d2246580ce Mon Sep 17 00:00:00 2001
From: build <build@localhost>
Date: Fri, 16 Oct 2026 16:44:27 +0500
Subject: [PATCH] Fix password store crash without an AffiliationService on
 Android

Restore-chrome-password-store builds the desktop LoginDatabase backend
on Android but the Android store factories pass a null
AffiliationService; wrapping it in an AffiliatedMatchHelper crashed in
AffiliatedMatchHelper::GetPSLExtensions on the first page with a
password field. Cromite does not hit this because its
Enable-native-Android-autofill patch (not taken here) makes the
factory create the service on Android. Create the helper only when a
service exists; the built-in backend then uses exact and PSL matches,
which is all it can do without the affiliation API anyway.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 .../factories/password_store_backend_factory.cc    | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/chrome/browser/password_manager/factories/password_store_backend_factory.cc b/chrome/browser/password_manager/factories/password_store_backend_factory.cc
index ee493ed0d3..751dd46388 100644
--- a/chrome/browser/password_manager/factories/password_store_backend_factory.cc
+++ b/chrome/browser/password_manager/factories/password_store_backend_factory.cc
@@ -76,9 +76,17 @@ CreatePasswordStoreBackend(
 #if !BUILDFLAG(IS_ANDROID)
   CHECK(affiliation_service);
 #endif
-  auto affiliated_match_helper =
-      std::make_unique<password_manager::AffiliatedMatchHelper>(
-          affiliation_service);
+  // On Android the factories pass no AffiliationService (the GMS backends do
+  // their own affiliation lookups), and AffiliatedMatchHelper dereferences it
+  // unconditionally. A null helper makes the built-in backend fall back to
+  // exact and PSL matches only.
+  std::unique_ptr<password_manager::AffiliatedMatchHelper>
+      affiliated_match_helper;
+  if (affiliation_service) {
+    affiliated_match_helper =
+        std::make_unique<password_manager::AffiliatedMatchHelper>(
+            affiliation_service);
+  }
   return std::make_unique<password_manager::PasswordStoreBuiltInBackend>(
       std::move(login_db), behavior, prefs, os_crypt_async,
       std::move(affiliated_match_helper));
